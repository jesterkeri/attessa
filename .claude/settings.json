{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(**/id_rsa)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/keystore/**)",
      "Read(**/.npmrc)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(npm publish *)",
      "Bash(forge script * --broadcast *)",
      "Bash(sui client publish *)",
      "Bash(supabase db push *)",
      "Bash(vercel --prod *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(gh pr create *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh",
            "timeout": 30,
            "statusMessage": "Loading build state..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-edit.sh",
            "timeout": 30,
            "statusMessage": "Checking protected paths..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.sh",
            "timeout": 30,
            "statusMessage": "Checking command..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-done.sh",
            "timeout": 60,
            "statusMessage": "Verifying completed work..."
          }
        ]
      }
    ]
  }
}
